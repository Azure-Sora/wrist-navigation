<template>
  <div class="page">
    <div class="home" if="{{ !settingsOpen }}">
      <text class="demo-label" if="{{ demo }}" style="font-size: {{ auxiliarySize }}px; font-family: {{ fontFamily }};">演示 · 非真实导航</text>
      <div class="navigation-stage" if="{{ guidance }}" style="top: {{ contentTop }}px; height: {{ contentHeight }}px;">
        <image class="arrow" src="{{ arrowSrc }}" style="left: {{ arrowLeft }}px; width: {{ arrowSize }}px; height: {{ arrowSize }}px;"></image>
        <text class="distance-value" style="top: {{ arrowSize + 8 }}px; font-size: {{ distanceSize }}px;">{{ distanceValue }}</text>
        <text class="distance-unit" style="top: {{ arrowSize + 70 }}px;">{{ distanceUnit }}</text>
        <list class="guidance-list" style="top: {{ guidanceTop }}px; height: {{ guidanceHeight }}px;">
          <list-item for="{{ guidanceLines }}" type="guidance" class="guidance-row" style="height: {{ rowHeight }}px;">
            <text class="guidance-text" style="height: {{ rowHeight }}px; line-height: {{ rowHeight }}px; font-size: {{ fontSize }}px; font-family: {{ guidanceFontFamily }};">{{ $item }}</text>
          </list-item>
        </list>
      </div>
      <div class="rest" if="{{ !guidance }}" style="top: {{ restTop }}px; height: {{ restHeight }}px;">
        <div class="rest-titles" style="height: {{ restTitleHeight }}px;">
          <text for="{{ titleLines }}" class="rest-title" style="height: {{ restTitleLineHeight }}px; line-height: {{ restTitleLineHeight }}px; font-size: {{ restFontSize }}px; font-family: {{ fontFamily }};">{{ $item }}</text>
        </div>
        <div class="rest-hints" style="top: {{ hintTop }}px; height: {{ hintsHeight }}px;">
          <text for="{{ hintLines }}" class="rest-hint" style="height: {{ hintHeight }}px; line-height: {{ hintHeight }}px; font-size: {{ hintSize }}px; font-family: {{ fontFamily }};">{{ $item }}</text>
        </div>
        <list class="details" if="{{ hasDetails }}" style="top: {{ detailsTop }}px; height: {{ detailsHeight }}px;">
          <list-item for="{{ rawLines }}" type="detail" class="detail-row" style="height: {{ hintHeight }}px;">
            <text class="raw" style="height: {{ hintHeight }}px; line-height: {{ hintHeight }}px; font-size: {{ hintSize }}px; font-family: {{ detailsFontFamily }};">{{ $item }}</text>
          </list-item>
        </list>
      </div>
      <div class="settings-entry" onclick="openSettings">
        <image class="settings-icon" src="/common/settings.png"></image>
      </div>
    </div>
    <div class="settings" if="{{ settingsOpen }}">
      <text class="back" onclick="settingsBack">‹</text>
      <text class="settings-title" style="font-size: {{ labelSize }}px; height: {{ titleHeight }}px; line-height: {{ titleHeight }}px; font-family: {{ fontFamily }};">{{ fontPickerOpen ? '选择字体' : '显示设置' }}</text>
      <list class="settings-list" if="{{ !fontPickerOpen }}" style="top: {{ settingsListTop }}px; height: {{ settingsListHeight }}px;">
        <list-item type="font-size" class="setting-block font-size-row" style="height: {{ settingRowHeight }}px;">
          <text class="setting-label" style="font-size: {{ labelSize }}px; height: {{ labelHeight }}px; line-height: {{ labelHeight }}px; font-family: {{ fontFamily }};">文字大小</text>
          <div class="stepper" style="top: {{ controlTop }}px; height: {{ buttonHeight }}px;">
            <text class="adjust decrease" onclick="adjust('fontSize', -1)" style="height: {{ buttonHeight }}px; line-height: {{ buttonHeight }}px; font-size: {{ adjustSize }}px;">−</text>
            <text class="setting-value" style="height: {{ buttonHeight }}px; line-height: {{ buttonHeight }}px; font-size: {{ fontSize }}px; font-family: {{ fontFamily }};">{{ fontSize }}</text>
            <text class="adjust increase" onclick="adjust('fontSize', 1)" style="height: {{ buttonHeight }}px; line-height: {{ buttonHeight }}px; font-size: {{ adjustSize }}px;">+</text>
          </div>
        </list-item>
        <list-item type="arrow-size" class="setting-block arrow-size-row" style="height: {{ settingRowHeight }}px;">
          <text class="setting-label" style="font-size: {{ labelSize }}px; height: {{ labelHeight }}px; line-height: {{ labelHeight }}px; font-family: {{ fontFamily }};">箭头大小</text>
          <div class="stepper" style="top: {{ controlTop }}px; height: {{ buttonHeight }}px;">
            <text class="adjust decrease" onclick="adjust('arrowSize', -2)" style="height: {{ buttonHeight }}px; line-height: {{ buttonHeight }}px; font-size: {{ adjustSize }}px;">−</text>
            <text class="setting-value" style="height: {{ buttonHeight }}px; line-height: {{ buttonHeight }}px; font-size: {{ fontSize }}px; font-family: {{ fontFamily }};">{{ arrowSize }}</text>
            <text class="adjust increase" onclick="adjust('arrowSize', 2)" style="height: {{ buttonHeight }}px; line-height: {{ buttonHeight }}px; font-size: {{ adjustSize }}px;">+</text>
          </div>
        </list-item>
        <list-item type="arrow-weight" class="setting-block arrow-weight-row" style="height: {{ settingRowHeight }}px;">
          <text class="setting-label" style="font-size: {{ labelSize }}px; height: {{ labelHeight }}px; line-height: {{ labelHeight }}px; font-family: {{ fontFamily }};">箭头粗细</text>
          <div class="stepper" style="top: {{ controlTop }}px; height: {{ buttonHeight }}px;">
            <text class="adjust decrease" onclick="adjust('arrowWeight', -1)" style="height: {{ buttonHeight }}px; line-height: {{ buttonHeight }}px; font-size: {{ adjustSize }}px;">−</text>
            <text class="setting-value" style="height: {{ buttonHeight }}px; line-height: {{ buttonHeight }}px; font-size: {{ fontSize }}px; font-family: {{ fontFamily }};">{{ arrowWeight }}</text>
            <text class="adjust increase" onclick="adjust('arrowWeight', 1)" style="height: {{ buttonHeight }}px; line-height: {{ buttonHeight }}px; font-size: {{ adjustSize }}px;">+</text>
          </div>
        </list-item>
        <list-item type="footer" class="settings-footer" style="height: {{ footerHeight }}px;">
          <text class="save-status" style="font-size: {{ auxiliarySize }}px; height: {{ auxiliaryHeight }}px; line-height: {{ auxiliaryHeight }}px; font-family: {{ fontFamily }};">{{ saveStatus }}</text>
          <text class="version" style="top: {{ auxiliaryHeight + 4 }}px; font-size: {{ auxiliarySize }}px; height: {{ auxiliaryHeight }}px; line-height: {{ auxiliaryHeight }}px; font-family: {{ fontFamily }};">腕上导航 v{{ versionName }}</text>
        </list-item>
        <list-item type="reset" class="reset-row" style="height: {{ buttonHeight + 16 }}px;">
          <text class="reset-defaults" onclick="resetSettings" style="font-size: {{ labelSize }}px; height: {{ buttonHeight }}px; line-height: {{ buttonHeight }}px; font-family: {{ fontFamily }};">恢复默认</text>
        </list-item>
      </list>
      <list class="font-options" if="{{ fontPickerOpen }}" style="top: {{ settingsListTop }}px; height: {{ settingsListHeight }}px;">
        <list-item for="{{ fontOptions }}" type="font-choice" class="font-choice-row" style="height: {{ fontChoiceHeight + 12 }}px;">
          <div class="font-choice" onclick="selectFont($item.id)" style="height: {{ fontChoiceHeight }}px; background-color: {{ font === $item.id ? '#253b2c' : '#101a14' }};">
            <text class="choice-name" style="font-size: {{ labelSize }}px; height: {{ labelHeight }}px; line-height: {{ labelHeight }}px; font-family: {{ fontFamily }};">{{ $item.name }}</text>
            <text class="choice-selected" if="{{ font === $item.id }}" style="font-size: {{ auxiliarySize }}px; height: {{ labelHeight }}px; line-height: {{ labelHeight }}px;">已选</text>
            <text class="choice-sample" style="top: {{ labelHeight + 8 }}px; font-family: {{ $item.family }}; font-size: {{ fontSize }}px; height: {{ titleHeight }}px; line-height: {{ titleHeight }}px;">直行200米</text>
          </div>
        </list-item>
      </list>
    </div>
  </div>
</template>

<script>
const protocol = require('../../common/protocol')
const presentation = require('../../common/presentation')
const settings = require('../../common/settings')
const haptics = require('../../common/haptics')
let hapticState = null
const manifest = require('../../manifest.json')
let preferenceStore = null
let connection = null
let latest = null
let navigationSeen = false
let receivedAt = 0
let connected = false
let timer = null
let connectionError = ''
let alive = false
let visible = false
let screenRequested = false
let screenRevision = 0
let screenError = ''

export default {
  private: {
    settingsOpen: false,
    font: settings.DEFAULTS.font,
    fontSize: settings.DEFAULTS.fontSize,
    arrowSize: settings.DEFAULTS.arrowSize,
    arrowWeight: settings.DEFAULTS.arrowWeight,
    fontPickerOpen: false,
    fontOptions: settings.FONT_OPTIONS,
    fontFamily: 'sans-serif',
    guidanceFontFamily: 'sans-serif',
    detailsFontFamily: 'sans-serif',
    fontName: '系统默认',
    labelSize: 24, hintSize: 22, auxiliarySize: 18,
    titleHeight: 42, labelHeight: 28, hintHeight: 31, auxiliaryHeight: 23,
    buttonHeight: 52, controlTop: 32, settingRowHeight: 96,
    fontSelectorHeight: 44, fontRowHeight: 56, footerHeight: 50,
    adjustSize: 35, fontChoiceHeight: 86,
    settingsListTop: 66, settingsListHeight: 398,
    restFontSize: 30, restTitleLineHeight: 42, titleLines: [], restTitleHeight: 42, hintTop: 54, hintsHeight: 62,
    saveStatus: '自动保存',
    versionName: manifest.versionName,
    guidanceLines: [' '],
    guidanceHeight: 48,
    rowHeight: 48,
    contentTop: 167,
    contentHeight: 146,
    arrowLeft: 105,
    guidanceTop: 98,
    hintLines: [],
    hasDetails: false,
    detailsTop: 0,
    detailsHeight: 0,
    restTop: 184,
    restHeight: 112,
    demo: false,
    arrowSrc: '/common/arrows/6/unknown.png',
    status: '等待导航',
    icon: '/common/unknown.png',
    distance: '',
    instruction: '',
    rawLines: [' '],
    header: '腕上导航',
    guidance: false,
    statusColor: '#64776b',
    distanceValue: '',
    distanceUnit: '',
    distanceSize: 72,
    hint: '在手机上连接小米运动健康'
  },
  onInit() {
    if (preferenceStore) preferenceStore.dispose()
    preferenceStore = null
    this.settingsOpen = false
    this.fontPickerOpen = false
    this.applySettings(settings.DEFAULTS)
    latest = null
    hapticState = haptics.create()
    navigationSeen = false
    receivedAt = 0
    connected = false
    connectionError = ''
    visible = false
    screenRequested = false
    screenError = ''
    alive = true
    this.paint()
  },
  // Establish interconnect only after the first screen has been created.
  onReady() {
    this.loadSettings()
    this.retry()
  },
  loadSettings() {
    if (!alive || preferenceStore) return
    try {
      preferenceStore = settings.createStore(require('@system.storage'),
        value => { if (alive) { this.applySettings(value); this.paint() } },
        value => { if (alive) this.saveStatus = value })
      preferenceStore.load()
    } catch (error) { this.saveStatus = '本次调整无法保存' }
  },
  applySettings(value) {
    const checked = settings.normalize(value)
    this.font = checked.font
    this.fontName = settings.fontOption(checked.font).name
    this.fontFamily = settings.fontOption(checked.font).family
    const type = presentation.typography(checked.fontSize)
    for (const field of Object.keys(type)) this[field] = type[field]
    this.settingsListTop = Math.max(106, 48 + type.titleHeight + 8)
    this.settingsListHeight = 416 - this.settingsListTop
    this.fontSize = checked.fontSize
    this.arrowSize = checked.arrowSize
    this.arrowWeight = checked.arrowWeight
  },
  adjust(field, change) {
    if (!alive || !settings.LIMITS[field]) return
    const value = this.currentSettings()
    value[field] += Number(change)
    const checked = settings.normalize(value)
    if (this[field] === checked[field]) return
    this.saveSettings(checked)
  },
  currentSettings() {
    return { font: this.font, fontSize: this.fontSize, arrowSize: this.arrowSize, arrowWeight: this.arrowWeight }
  },
  saveSettings(value) {
    if (!alive) return
    const checked = settings.normalize(value)
    this.applySettings(checked)
    this.paint()
    if (preferenceStore) preferenceStore.save(checked)
    else this.saveStatus = '本次调整无法保存'
  },
  resetSettings() { this.saveSettings(settings.DEFAULTS) },
  openFonts() { this.fontPickerOpen = true },
  selectFont(id) {
    if (!alive || settings.FONTS.indexOf(id) < 0) return
    const value = this.currentSettings()
    value.font = id
    this.saveSettings(value)
    this.fontPickerOpen = false
  },
  openSettings() { this.settingsOpen = true; this.fontPickerOpen = false; this.paint() },
  closeSettings() { this.fontPickerOpen = false; this.settingsOpen = false; this.paint() },
  settingsBack() {
    if (this.fontPickerOpen) this.fontPickerOpen = false
    else this.closeSettings()
  },
  onBackPress() {
    if (this.settingsOpen) { this.settingsBack(); return true }
    return false
  },
  onShow() {
    visible = true
    this.paint()
    if (connection) this.retry()
  },
  onHide() {
    visible = false
    if (timer) clearTimeout(timer)
    timer = null
    this.keepScreenOn(false)
  },
  onDestroy() {
    if (preferenceStore) preferenceStore.dispose()
    preferenceStore = null
    alive = false
    visible = false
    // Release again if the previous off request failed or is still pending.
    this.keepScreenOn(false, true)
    if (timer) clearTimeout(timer)
    timer = null
    if (connection) {
      try {
        connection.onmessage = () => {}
        connection.onopen = () => {}
        connection.onclose = () => {}
        connection.onerror = () => {}
      } catch (error) { /* Some firmware rejects callback changes after disconnect. */ }
    }
    connection = null
    latest = null
  },
  ready() {
    this.send({ v: 1, type: 'ready' })
  },
  send(message) {
    if (!connection || !alive) return
    try {
      connection.send({
        data: JSON.stringify(message),
        fail: (data, code) => this.failed('发送失败', data, code)
      })
    } catch (error) { this.failed('发送失败', error) }
  },
  failed(stage, data, code) {
    if (!alive) return
    connected = false
    connectionError = presentation.errorText(stage, data, code)
    this.paint()
  },
  retry() {
    if (!alive) return
    connectionError = ''
    try {
      if (!connection) {
        // Lazy loading keeps missing/failed firmware APIs from aborting page creation.
        const interconnect = require('@system.interconnect')
        connection = interconnect.instance()
        connection.onopen = () => {
          if (!alive) return
          connected = true
          connectionError = ''
          this.ready()
          this.paint()
        }
        connection.onclose = data => this.failed('连接断开', data)
        connection.onerror = data => this.failed('连接异常', data)
        connection.onmessage = event => {
          if (!alive) return
          const packet = protocol.decode(event && event.data)
          if (!protocol.accept(latest, packet)) return
          const alert = hapticState.update(packet)
          if (alert && visible && !this.settingsOpen) {
            try { require('@system.vibrator').vibrate({ mode: alert }) } catch (error) { /* Rendering must survive a missing vibration API. */ }
          }
          latest = packet
          receivedAt = Date.now()
          connected = true
          connectionError = ''
          if (visible) this.paint()
          this.send({ v: 1, type: 'ack', session: packet.session, seq: packet.seq })
          if (packet.status === 'active') navigationSeen = true
          if (packet.status === 'ended' && navigationSeen) {
            navigationSeen = false
            if (visible && !this.settingsOpen) {
              this.keepScreenOn(false)
              try { this.$app.exit() } catch (error) { /* Show the ended state if firmware exit is unavailable. */ }
            }
          }
        }
      }
      connection.getReadyState({
        success: data => {
          if (!alive) return
          connected = !!data && data.status === 1
          connectionError = ''
          if (connected) this.ready()
          this.paint()
        },
        fail: (data, code) => this.failed('连接检查失败', data, code)
      })
    } catch (error) {
      connection = null
      this.failed('互联初始化失败', error)
    }
    this.paint()
  },
  scheduleExpiry() {
    if (timer) clearTimeout(timer)
    timer = null
    if (!alive || !visible || !connected || !latest) return
    if (latest.status !== 'active' && latest.status !== 'demo') return
    const remaining = protocol.EXPIRY_MS - (Date.now() - receivedAt)
    if (remaining > 0) timer = setTimeout(() => { timer = null; this.paint() }, remaining)
  },
  keepScreenOn(value, force) {
    if (!force && screenRequested === value) return
    screenRequested = value
    screenError = ''
    const revision = ++screenRevision
    const fail = (data, code) => {
      if (!alive || revision !== screenRevision) return
      screenError = presentation.errorText(value ? '常亮开启失败' : '常亮关闭失败', data, code)
      this.paint()
    }
    try {
      // Load lazily: a missing brightness API must not stop navigation rendering.
      const brightness = require('@system.brightness')
      brightness.setKeepScreenOn({ keepScreenOn: value, fail })
    } catch (error) { fail(error) }
  },
  paint() {
    const now = Date.now()
    const age = now - receivedAt
    let view = protocol.present(latest, age, connected)
    this.keepScreenOn(visible && !this.settingsOpen && !!view.live && latest.keepScreenOn !== false)
    if (connectionError) {
      view.status = '连接不可用'
      view.rawText = connectionError
    }
    this.scheduleExpiry()
    if (this.status !== view.status) this.status = view.status
    const icon = '/common/' + view.icon + '.png'
    if (this.icon !== icon) this.icon = icon
    if (this.distance !== view.distance) this.distance = view.distance
    if (this.instruction !== view.instruction) this.instruction = view.instruction
    const layout = presentation.layout(view)
    this.demo = view.status === '演示 · 非真实导航'
    this.arrowSrc = '/common/arrows/' + this.arrowWeight + '/' + view.icon + '.png'
    const navigation = presentation.navigationLayout(view, this, screenError)
    for (const field of ['rowHeight', 'guidanceHeight', 'contentTop', 'contentHeight', 'arrowLeft', 'guidanceTop']) {
      if (this[field] !== navigation[field]) this[field] = navigation[field]
    }
    if (navigation.guidanceLines.join('\n') !== this.guidanceLines.join('\n')) this.guidanceLines = navigation.guidanceLines
    for (const field of ['header', 'guidance', 'statusColor', 'distanceValue', 'distanceUnit', 'distanceSize', 'hint']) {
      if (this[field] !== layout[field]) this[field] = layout[field]
    }
    this.guidanceFontFamily = settings.fontForText(this.font, navigation.guidanceLines.join(''))
    const rest = presentation.restLayout(view, screenError, this)
    this.detailsFontFamily = settings.fontForText(this.font, rest.rawLines.join(''))
    if (rest.titleLines.join('\n') !== this.titleLines.join('\n')) this.titleLines = rest.titleLines
    for (const field of ['restFontSize', 'restTitleLineHeight', 'restTitleHeight', 'hintTop', 'hintsHeight', 'hasDetails', 'detailsTop', 'detailsHeight', 'restTop', 'restHeight']) {
      if (this[field] !== rest[field]) this[field] = rest[field]
    }
    if (rest.hintLines.join('\n') !== this.hintLines.join('\n')) this.hintLines = rest.hintLines
    // Unchanged heartbeats renew expiry without rebuilding native views.
    if (rest.rawLines.join('\n') !== this.rawLines.join('\n')) this.rawLines = rest.rawLines
  }
}
</script>

<style>
.page { position: relative; width: 192px; height: 490px; background-color: #000000; }
.home { position: absolute; top: 0px; left: 0px; width: 192px; height: 490px; }
.navigation-stage { position: absolute; left: 12px; width: 168px; height: 110px; }
.arrow { position: absolute; top: 0px; width: 42px; height: 42px; object-fit: contain; }
.guidance-list { position: absolute; left: 0px; width: 168px; height: 42px; }
.guidance-row { width: 168px; height: 42px; flex-shrink: 0; }
.guidance-text { width: 168px; height: 42px; color: #ffffff; font-size: 30px; line-height: 42px; text-align: center; }
.settings-entry { position: absolute; left: 64px; top: 414px; width: 64px; height: 64px; border-radius: 32px; background-color: #101a14; }
.settings-icon { position: absolute; left: 11px; top: 11px; width: 42px; height: 42px; object-fit: contain; }
.demo-label { position: absolute; top: 24px; left: 12px; width: 168px; height: 38px; color: #d4b57b; text-align: center; }
.rest { position: absolute; left: 12px; width: 168px; height: 116px; }
.rest-titles { position: absolute; top: 0px; left: 0px; width: 168px; flex-direction: column; }
.rest-title { width: 168px; flex-shrink: 0; color: #f4f8f1; text-align: center; }
.rest-hints { position: absolute; left: 0px; width: 168px; flex-direction: column; }
.rest-hint { width: 168px; flex-shrink: 0; color: #9aafa0; text-align: center; }
.details { position: absolute; left: 0px; width: 168px; height: 84px; }
.detail-row { width: 168px; height: 31px; }
.raw { width: 168px; color: #9aafa0; text-align: center; }
.settings { position: absolute; top: 0px; left: 0px; width: 192px; height: 490px; background-color: #000000; }
.back { position: absolute; left: 16px; top: 48px; width: 44px; height: 48px; color: #ffffff; font-size: 38px; line-height: 48px; text-align: center; }
.settings-title { position: absolute; left: 56px; top: 48px; width: 124px; color: #ffffff; }
.settings-list { position: absolute; left: 12px; top: 66px; width: 168px; height: 398px; }
.font-row { width: 168px; height: 56px; }
.font-selector { position: absolute; top: 0px; left: 0px; width: 168px; height: 44px; background-color: #17261c; border-radius: 12px; }
.font-label { position: absolute; left: 8px; top: 0px; width: 48px; color: #ffffff; }
.font-name { position: absolute; left: 54px; top: 0px; width: 96px; color: #ffffff; text-align: right; }
.font-chevron { position: absolute; left: 150px; top: 0px; width: 18px; color: #d9e6dd; font-size: 28px; text-align: center; }
.setting-block { width: 168px; height: 96px; }
.setting-label { position: absolute; top: 0px; left: 0px; width: 168px; color: #b7c9bd; }
.stepper { position: absolute; left: 0px; width: 168px; height: 52px; }
.adjust { position: absolute; top: 0px; width: 44px; height: 52px; background-color: #1a281f; border-radius: 10px; color: #e8f2eb; text-align: center; }
.decrease { left: 0px; }
.increase { left: 124px; }
.setting-value { position: absolute; top: 0px; left: 44px; width: 80px; color: #ffffff; text-align: center; }
.settings-footer { width: 168px; height: 50px; }
.save-status { position: absolute; left: 0px; top: 0px; width: 168px; color: #95ad9f; text-align: center; }
.version { position: absolute; left: 0px; width: 168px; color: #73857a; text-align: center; }
.reset-row { width: 168px; height: 68px; }
.reset-defaults { position: absolute; left: 0px; top: 8px; width: 168px; color: #b7c9bd; background-color: #101a14; border-radius: 12px; text-align: center; }
.font-options { position: absolute; left: 12px; top: 66px; width: 168px; height: 398px; }
.font-choice-row { width: 168px; height: 98px; }
.font-choice { position: absolute; left: 0px; top: 0px; width: 168px; height: 86px; border-radius: 12px; }
.choice-name { position: absolute; left: 12px; top: 6px; width: 108px; color: #b7c9bd; }
.choice-selected { position: absolute; left: 118px; top: 6px; width: 46px; color: #80f5be; text-align: right; }
.choice-sample { position: absolute; left: 12px; width: 144px; color: #ffffff; }
.distance-value { position: absolute; left: 0px; width: 168px; height: 64px; line-height: 64px; color: #ffffff; text-align: center; }
.distance-unit { position: absolute; left: 0px; width: 168px; height: 28px; line-height: 28px; font-size: 22px; color: #80f5be; text-align: center; }
</style>
